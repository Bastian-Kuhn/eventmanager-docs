# Copy to deploy/deploy.env (gitignored) and fill in. deploy/deploy.sh reads it.
# Host and user of the Hetzner web space, kept out of the repository.
TA_DEPLOY_HOST=wwwNNN.your-server.de
TA_DEPLOY_USER=example
# Remote path relative to the SFTP home. Default in deploy.sh:
# TA_DEPLOY_DIR=public_html/docs.tourenanmeldung
# Optional, only for a test without SSH key. Better: ssh-copy-id once.
# TA_DEPLOY_PASS=
